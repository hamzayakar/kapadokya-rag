# --- Data & Vector Stores ---
# Ignore everything inside data/ directories
data/raw_docs/*/*
data/processed_chunks/*/*
data/vector_stores/*/*
data/evaluation_data/*

# EXCEPT: Do not ignore directories themselves, and keep .gitkeep files
!data/**/.gitkeep

