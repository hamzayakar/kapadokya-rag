# --- Environment Variables ---
.env

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/

# --- IDEs & OS Files ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Logs & Docs ---
*.log
